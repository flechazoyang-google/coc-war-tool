<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) 数据提取规则：排除 WebDAV 凭据，防止密码被备份到云端 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="coc_webdav_prefs.xml" />
        <exclude
            domain="sharedpref"
            path="coc_webdav_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="coc_webdav_prefs.xml" />
        <exclude
            domain="sharedpref"
            path="coc_webdav_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
