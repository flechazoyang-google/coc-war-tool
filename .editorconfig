# EditorConfig: 统一编辑器/IDE 格式（https://editorconfig.org）
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin 官方风格：连续缩进 4 空格
[*.kt]
indent_size = 4
continuation_indent_size = 4

[*.{yml,yaml,json,properties,toml}]
indent_size = 2

[*.xml]
indent_size = 4
